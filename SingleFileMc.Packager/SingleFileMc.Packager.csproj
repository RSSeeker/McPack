<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>SingleFileMc.Packager</AssemblyName>
    <RootNamespace>SingleFileMc.Packager</RootNamespace>

    <PublishAot>true</PublishAot>
    <_SuppressWinFormsTrimError>true</_SuppressWinFormsTrimError>
    <StripSymbols>true</StripSymbols>
    <StackTraceSupport>true</StackTraceSupport>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="StubData.g.cs" />
  </ItemGroup>

  <Target Name="GenerateStubData" BeforeTargets="BeforeBuild">
    <PropertyGroup>
      <StubRelease>$(MSBuildProjectDirectory)\..\SingleFileMc\bin\Release\net10.0\win-x64\publish\SingleFileMc.exe</StubRelease>
      <StubDebug>$(MSBuildProjectDirectory)\..\SingleFileMc\bin\Debug\net10.0\win-x64\publish\SingleFileMc.exe</StubDebug>
      <StubFile>$(StubRelease)</StubFile>
      <StubFile Condition="!Exists('$(StubRelease)') and Exists('$(StubDebug)')">$(StubDebug)</StubFile>
    </PropertyGroup>
    <Message Importance="high" Text="GenerateStubData: searching for stub at $(StubFile)" />
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\GenerateStubData.ps1&quot; -StubFile &quot;$(StubFile)&quot;"
          WorkingDirectory="$(MSBuildProjectDirectory)" />
    <ItemGroup>
      <Compile Include="StubData.g.cs" />
    </ItemGroup>
  </Target>

</Project>